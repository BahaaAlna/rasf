# Copy to `.env.local` and fill in from the Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
# These are not secrets (they ship in the browser bundle); the security
# rules in firestore.rules are what keep the data safe.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to talk to the local Firebase emulators instead
# (`npm run emulators`) — no real project needed.
VITE_USE_EMULATORS=false
