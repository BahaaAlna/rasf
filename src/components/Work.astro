---
/*
  Selected work: a few words about the studio, then a short list of
  projects. Kept deliberately small — names and a line of metadata, no
  images — because each row is only a doorway: the project itself lives
  on its own page, `/work/<slug>`.

  On a hovering pointer each row also calls up its project's picture,
  which floats after the pointer as if weightless — the same drift as the
  cards in "What is Rasf?". That is the only script here; everything else
  is CSS, and the shared [data-reveal] observer brings the section in.
*/
import type { WorkSection } from '../lib/content';
import { localizePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** The section's heading — the nav's own word for it. */
  title: string;
  copy: WorkSection;
}

const { locale, title, copy } = Astro.props;
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="work__inner u-wrap">
    <header class="work__about">
      <h2 id="work-title" class="work__title" data-reveal>{title}</h2>
      <p class="work__intro" data-reveal style="--reveal-delay: 0.08s">{copy.intro}</p>
    </header>

    <div class="work__list">
      <p class="u-mono" data-reveal>{copy.listLabel}</p>
      <ol>
        {
          copy.projects.map((project, i) => (
            <li data-reveal style={`--reveal-delay: ${0.06 * (i + 1)}s`}>
              <a class="row" href={localizePath(`/work/${project.slug}`, locale)} data-shot={i}>
                <span class="row__n u-mono">
                  {(i + 1).toLocaleString(locale === 'ar' ? 'ar-EG' : 'en', { minimumIntegerDigits: 2 })}
                </span>
                <span class="row__name">{project.name}</span>
                <span class="row__meta u-mono">
                  {project.kind} · {project.year}
                </span>
                <svg class="row__arrow u-flip" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h15M13 6l6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ol>
      <a class="work__all u-mono" href={localizePath('/work', locale)} data-reveal>
        {copy.allLabel}
        <svg class="u-flip" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h15M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>

  {/*
    The pictures, one per project, stacked so moving between rows is a
    cross-fade rather than a swap. Decorative: each row already says
    what the project is, so they are hidden from assistive tech.
  */}
  <figure class="shot" aria-hidden="true">
    {
      copy.projects.map((project, i) => (
        <img src={project.image} alt="" width="800" height="600" decoding="async" data-shot={i} />
      ))
    }
  </figure>
</section>

<script>
  /** How hard the picture is pulled toward the pointer. Lower floats more. */
  const PULL = 0.03;
  /** Velocity kept each frame. Closer to 1 overshoots and drifts longer. */
  const DRAG = 0.88;
  /** Gap between the pointer and the bottom of the picture above it. */
  const GAP = 28;

  const root = document.getElementById('work');
  const shot = root?.querySelector<HTMLElement>('.shot');
  const list = root?.querySelector<HTMLElement>('.work__list ol');

  // Only for a pointer that can hover: on touch a tap is a click, and the
  // picture would flash up just as the page leaves.
  if (root && shot && list && window.matchMedia('(hover: hover)').matches) {
    const still = !window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const shots = [...shot.querySelectorAll<HTMLImageElement>('img')];
    const pointer = { x: 0, y: 0 };
    const at = { x: 0, y: 0, vx: 0, vy: 0 };
    let on = false;
    let frame = 0;

    /** Where it wants to be: centred over the pointer, kept on screen. */
    const aim = () => {
      const w = shot.offsetWidth;
      const h = shot.offsetHeight;
      return {
        x: Math.min(Math.max(pointer.x - w / 2, 12), window.innerWidth - w - 12),
        y: Math.min(Math.max(pointer.y - h - GAP, 12), window.innerHeight - h - 12),
      };
    };

    /*
      A soft spring that overshoots and settles, a slow bob that never
      quite stops, and a tilt into the direction it is being pulled — the
      picture hangs off the pointer rather than being stuck to it.
    */
    const step = () => {
      const target = aim();
      if (still) {
        at.x = target.x;
        at.y = target.y;
      } else {
        at.vx = (at.vx + (target.x - at.x) * PULL) * DRAG;
        at.vy = (at.vy + (target.y - at.y) * PULL) * DRAG;
        at.x += at.vx;
        at.y += at.vy;
      }
      const t = performance.now() / 1000;
      const bobX = still ? 0 : Math.sin(t * 0.9) * 4;
      const bobY = still ? 0 : Math.sin(t * 1.3 + 1) * 6;
      const tilt = still ? 0 : Math.max(-8, Math.min(8, at.vx * 0.35)) + Math.sin(t * 0.7);
      shot.style.transform =
        'translate(' + (at.x + bobX).toFixed(1) + 'px, ' + (at.y + bobY).toFixed(1) + 'px) rotate(' + tilt.toFixed(2) + 'deg)';
      frame = on ? requestAnimationFrame(step) : 0;
    };

    const show = (index: number) => {
      shots.forEach((img, i) => img.classList.toggle('is-current', i === index));
      if (on) return;
      // Opening: start where it is going, not wherever it was let go.
      on = true;
      const start = aim();
      Object.assign(at, { x: start.x, y: start.y, vx: 0, vy: 0 });
      shot.classList.add('is-on');
      if (!frame) frame = requestAnimationFrame(step);
    };

    const hide = () => {
      on = false;
      shot.classList.remove('is-on');
    };

    const track = (event: PointerEvent) => {
      pointer.x = event.clientX;
      pointer.y = event.clientY;
    };

    list.querySelectorAll<HTMLElement>('[data-shot]').forEach((row) => {
      row.addEventListener('pointerenter', (event) => {
        track(event);
        show(Number(row.dataset.shot));
      });
    });
    list.addEventListener('pointermove', track, { passive: true });
    // Left as a whole, not row by row: crossing from one row to the next
    // only changes the picture.
    list.addEventListener('pointerleave', hide);
  }
</script>

<style>
  .work {
    border-block-start: 1px solid var(--rule);
    padding-block: var(--space-2xl);
  }

  /*
    Two columns on a wide screen — who we are on the start side, what we
    have built beside it — and one stacked column anywhere narrower.
  */
  .work__inner {
    display: grid;
    gap: var(--space-xl) var(--space-2xl);
  }

  @media (min-width: 60rem) {
    .work__inner {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }

  .work__title {
    font-size: var(--step-3);
    color: var(--ink);
  }

  .work__intro {
    margin-block-start: var(--space-md);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-muted);
  }

  :global([dir='rtl']) .work__title {
    font-size: calc(var(--step-3) * var(--ar-scale));
  }

  :global([dir='rtl']) .work__intro {
    font-size: calc(var(--step-1) * var(--ar-scale));
    line-height: calc(1.45 * var(--ar-leading));
  }

  .work__list ol {
    margin-block-start: var(--space-sm);
    border-block-start: 1px solid var(--rule);
  }

  /*
    One row per project, the whole row the link. A hairline underneath
    fills with the accent from the reading edge on hover, and the name
    and arrow lean the way the reader is going.
  */
  .row {
    --lean: 0.4rem;
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto 1.25rem;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--rule);
  }

  :global([dir='rtl']) .row {
    --lean: -0.4rem;
  }

  .row::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-hover-out) var(--ease-out-expo);
  }

  :global([dir='rtl']) .row::after {
    transform-origin: right;
  }

  .row__name {
    font-size: var(--step-1);
    color: var(--ink);
    transition: transform var(--dur-hover-out) var(--ease-out-expo);
  }

  :global([dir='rtl']) .row__name {
    font-size: calc(var(--step-1) * var(--ar-scale));
  }

  .row__arrow {
    inline-size: 1.25rem;
    align-self: center;
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 1.5;
    transition:
      translate var(--dur-hover-out) var(--ease-out-expo),
      stroke var(--dur-hover-out) var(--ease-out-expo);
  }

  .row:hover::after,
  .row:focus-visible::after {
    transform: scaleX(1);
    transition-duration: var(--dur-hover-in);
  }

  .row:hover .row__name,
  .row:focus-visible .row__name {
    transform: translateX(var(--lean));
    transition-duration: var(--dur-hover-in);
  }

  /* `translate`, not `transform`: the arrow is already mirrored under RTL
     by .u-flip, and the two would overwrite each other. */
  .row:hover .row__arrow,
  .row:focus-visible .row__arrow {
    translate: calc(var(--lean) * 1.5) 0;
    stroke: var(--accent);
    transition-duration: var(--dur-hover-in);
  }

  /* On a phone the metadata drops under the name rather than squeezing it. */
  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 2rem 1fr 1.25rem;
      row-gap: var(--space-2xs);
    }

    .row__meta {
      grid-column: 2;
      grid-row: 2;
    }

    .row__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }

  .work__all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-lg);
    color: var(--ink);
  }

  .work__all svg {
    inline-size: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .work__all:hover {
    color: var(--accent);
  }

  /*
    The floating picture. Fixed to the viewport, because it follows the
    pointer's screen position; moved only by the transform the script
    sets each frame, so only opacity is transitioned here.
  */
  .shot {
    position: fixed;
    inset-block-start: 0;
    left: 0;
    z-index: 20;
    inline-size: clamp(14rem, 22vw, 20rem);
    aspect-ratio: 4 / 3;
    pointer-events: none;
    opacity: 0;
    transform-origin: 50% 100%;
    will-change: transform;
    transition: opacity var(--dur-base) var(--ease-out-expo);
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.35);
  }

  .shot.is-on {
    opacity: 1;
  }

  .shot img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0;
    scale: 1.06;
    transition:
      opacity var(--dur-base) var(--ease-out-expo),
      scale var(--dur-hover-in) var(--ease-out-expo);
  }

  .shot img.is-current {
    opacity: 1;
    scale: 1;
  }

  /* Nothing to hover with: the rows are plain links. */
  @media (hover: none) {
    .shot {
      display: none;
    }
  }
</style>
