---
/*
  About: a manifesto set very large, a band of the technologies we build
  with under it, then how a project runs.

  The manifesto inks in word by word as the page scrolls past it: every
  word starts faint and darkens in reading order, laid one after another
  like the stones in the name. `about.ts` measures the scroll and hands
  CSS a single number, `--p`; the stagger is all CSS. The process line
  draws the same way, from `--t`.

  No hairline across the top: the Services cards above already end with
  an edge of their own.
*/
import type { AboutSection } from '../../../lib/content';
import type { Locale } from '../../../lib/i18n';
import { TOOLS } from '../../../data/about';

interface Props {
  locale: Locale;
  /** The section's heading — the nav's own word for it. */
  title: string;
  copy: AboutSection;
}

const { locale, title, copy } = Astro.props;
const number = (n: number) => n.toLocaleString(locale === 'ar' ? 'ar-EG' : 'en', { minimumIntegerDigits: 2 });

/*
  One span per word, so each can ink in on its own. The closing full stop
  is split off and takes the accent — the dot from the logotype.
*/
const text = copy.manifesto.trim();
const stop = text.endsWith('.');
const words = (stop ? text.slice(0, -1) : text).split(/\s+/);
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="u-wrap">
    <h2 id="about-title" class="about__label u-mono" data-reveal>{title}</h2>

    <p class="manifesto" data-manifesto style={`--n: ${words.length}`}>
      {
        words.map((word, i) => (
          <>
            <span class="manifesto__word" style={`--i: ${i}`}>
              {word}
              {stop && i === words.length - 1 && <span class="manifesto__dot">.</span>}
            </span>{' '}
          </>
        ))
      }
    </p>
  </div>

  <div class="tools">
    <p class="tools__label u-mono">{copy.toolsLabel}</p>
    <div class="tools__track">
      {
        [0, 1].map((copyIndex) => (
          <ul class="tools__run" aria-hidden={copyIndex === 1 ? 'true' : undefined}>
            {TOOLS.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <div class="u-wrap">
    <div class="process">
      <h3 class="process__title" data-reveal>{copy.processTitle}</h3>
      <div class="steps" data-process style={`--n: ${copy.steps.length}`}>
        <span class="steps__line" aria-hidden="true"></span>
        <ol class="steps__list">
          {
            copy.steps.map((step, i) => (
              <li class="step" style={`--i: ${i}`}>
                <span class="step__mark" aria-hidden="true" />
                <span class="step__n u-mono">{number(i + 1)}</span>
                <h4 class="step__title">{step.title}</h4>
                <p class="step__note">{step.note}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

  </div>
</section>

<script>
  import { initAbout } from './about';

  document.addEventListener('astro:page-load', initAbout);
</script>

<style>
  .about {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .about__label {
    margin-block-end: var(--space-lg);
  }

  /* ---- Manifesto ------------------------------------------------------ */

  .manifesto {
    --p: 1;
    max-inline-size: 22ch;
    font-size: var(--hero-size);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  :global([dir='rtl']) .manifesto {
    font-size: calc(var(--hero-size) * var(--ar-scale));
    line-height: calc(1.02 * var(--ar-leading));
    letter-spacing: 0;
  }

  /*
    Each word's share of the scroll: word i is faint until the progress
    reaches it, then darkens over the next word's worth. With --p at 1 —
    no script, or motion reduced — every word simply reads in full.
  */
  .manifesto__word {
    opacity: calc(0.16 + 0.84 * clamp(0, var(--p) * var(--n) - var(--i), 1));
    transition: opacity var(--dur-base) var(--ease-out-power3);
  }

  .manifesto__dot {
    color: var(--accent);
  }

  /* ---- Process -------------------------------------------------------- */

  .process {
    margin-block-start: var(--space-3xl);
  }

  .process__title {
    font-size: var(--step-2);
    color: var(--ink);
  }

  :global([dir='rtl']) .process__title {
    font-size: calc(var(--step-2) * var(--ar-scale));
  }

  /*
    The steps hang off one line that draws itself as the page scrolls
    through them. `about.ts` sets --t from 0 to 1; each step lights as the
    line reaches its mark — --lit rises from 0 to 1 over the last stretch
    before it — so the stagger is all CSS.
  */
  .steps {
    --t: 1;
    --gap: var(--space-lg);
    --mark: 0.75rem;
    position: relative;
    margin-block-start: var(--space-xl);
  }

  .steps__list {
    display: grid;
    gap: var(--space-xl) var(--gap);
  }

  .step {
    --lit: clamp(0, (var(--t) * (var(--n) - 1) - var(--i)) * 6 + 1, 1);
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }

  /* The track, faint, and the drawn line over it. */
  .steps::before,
  .steps__line {
    content: '';
    position: absolute;
    background: var(--rule);
  }

  .steps__line {
    background: var(--ink);
  }

  .step__mark {
    inline-size: var(--mark);
    block-size: var(--mark);
    margin-block-end: var(--space-sm);
    border: 1px solid var(--ink);
    background: color-mix(in srgb, var(--accent) calc(var(--lit) * 100%), var(--paper));
    border-color: color-mix(in srgb, var(--accent) calc(var(--lit) * 100%), var(--ink));
    transition:
      background var(--dur-base) var(--ease-out-power3),
      border-color var(--dur-base) var(--ease-out-power3);
  }

  .step__n,
  .step__title,
  .step__note {
    opacity: calc(0.3 + 0.7 * var(--lit));
    transition: opacity var(--dur-base) var(--ease-out-power3);
  }

  .step__title {
    font-size: var(--step-1);
    color: var(--ink);
  }

  .step__note {
    max-inline-size: 26ch;
    color: var(--ink-muted);
    line-height: 1.5;
  }

  :global([dir='rtl']) .step__title {
    font-size: calc(var(--step-1) * var(--ar-scale));
  }

  :global([dir='rtl']) .step__note {
    line-height: calc(1.5 * var(--ar-leading));
  }

  /*
    Wide: the steps side by side, the line running across their marks —
    from the first column's start to the last one's, which is where the
    marks sit.
  */
  @media (min-width: 60rem) {
    .steps__list {
      grid-template-columns: repeat(var(--n), 1fr);
    }

    .steps::before,
    .steps__line {
      inset-block-start: calc(var(--mark) / 2);
      inset-inline-start: calc(var(--mark) / 2);
      block-size: 1px;
      inline-size: calc((100% - (var(--n) - 1) * var(--gap)) * (var(--n) - 1) / var(--n) + (var(--n) - 1) * var(--gap));
    }

    .steps__line {
      transform: scaleX(var(--t));
      transform-origin: left;
    }

    :global([dir='rtl']) .steps__line {
      transform-origin: right;
    }

    .step__mark {
      position: relative;
    }
  }

  /* Narrow: the steps stacked, the line running down beside them. */
  @media (max-width: 59.99rem) {
    .steps__list {
      padding-inline-start: calc(var(--mark) + var(--space-md));
    }

    .step__mark {
      position: absolute;
      z-index: 1;
      inset-block-start: 0;
      inset-inline-start: calc((var(--mark) + var(--space-md)) * -1);
    }

    /*
      Steps differ in height here, so one line can't know where the last
      mark is. Each step draws its own stretch instead — from its mark to
      the next one — and fills it as the drawing passes through.
    */
    .steps::before,
    .steps__line {
      display: none;
    }

    .step:not(:last-child)::before,
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      inset-block-start: calc(var(--mark) / 2);
      inset-inline-start: calc((var(--mark) + var(--space-md)) * -1 + var(--mark) / 2);
      inline-size: 1px;
      block-size: calc(100% + var(--space-xl));
      background: var(--rule);
    }

    .step:not(:last-child)::after {
      background: var(--ink);
      transform: scaleY(clamp(0, var(--t) * (var(--n) - 1) - var(--i), 1));
      transform-origin: top;
    }
  }

  /* ---- Tools ---------------------------------------------------------- */

  /*
    What we build with, running past in a band across the full width. Two
    copies of the list end to end, moved left by exactly one: the second
    lands where the first began, so the loop has no seam. Pauses under the
    pointer, and with motion reduced the band simply sits, wrapped.
  */
  .tools {
    display: flex;
    align-items: center;
    margin-block-start: var(--space-2xl);
    border-block: 1px solid var(--rule);
  }

  .tools__label {
    flex-shrink: 0;
    padding-inline: var(--gutter) var(--space-lg);
    padding-block: var(--space-md);
    border-inline-end: 1px solid var(--rule);
  }

  .tools__track {
    /* Product names, so they read left to right on both pages. */
    direction: ltr;
    display: flex;
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .tools__run {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-xl);
    padding-inline-end: var(--space-xl);
    padding-block: var(--space-md);
    list-style: none;
    animation: tools 40s linear infinite;
  }

  .tools__run li {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    font-family: var(--font-display-en);
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }

  /* A small square of the accent between names. */
  .tools__run li::after {
    content: '';
    inline-size: 0.4rem;
    block-size: 0.4rem;
    background: var(--accent);
  }

  .tools:hover .tools__run {
    animation-play-state: paused;
  }

  @keyframes tools {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tools__run {
      flex-wrap: wrap;
      flex-shrink: 1;
      animation: none;
    }

    .tools__run + .tools__run {
      display: none;
    }
  }

</style>
