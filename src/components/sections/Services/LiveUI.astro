---
/*
  The picture on a service card: a tiny screen doing the thing the card
  is about, on a loop.

    website  code types out in an editor; the page it describes builds
             itself alongside, block by block
    app      revenue counts up while a line chart draws itself out to
             a marked point
    store    a pointer picks a size and adds to cart twice; a toast
             confirms and the badge counts along
    brand    the wordmark tightens onto its guides, the dot drops in,
             it is selected like in a design tool, and the palette laid out

  Square-cornered and hairline-drawn like the rest of the page, with the
  accent on one thing per screen.

  Pure CSS. Every screen's resting style is its finished state and the
  keyframes only animate away from it, so with motion reduced — or with
  no JS to start it — the finished screen simply sits there. With JS, it
  waits paused until the shared [data-reveal] observer brings it into
  view, then plays.

  Sized off its own width (container units), so it scales with the card.
  Decorative: the card's heading already says what the service is.
*/
export type LiveKind = 'website' | 'app' | 'store' | 'brand';

interface Props {
  kind: LiveKind;
}

const { kind } = Astro.props;

/** The chart's line, in the SVG's 0–100 × 0–50 box: a rising, uneven year. */
const LINE = 'M0 42 L12 38 L24 40 L36 31 L48 33 L60 24 L72 26 L84 15 L96 9';
const AREA = `${LINE} L96 50 L0 50 Z`;
---

<div class={`ui ui--${kind}`} aria-hidden="true" data-reveal>
  <div class="ui__frame">
    {
      kind === 'website' && (
        <>
          <div class="bar">
            <i />
            <i />
            <i />
            <span class="bar__url">rasf.studio</span>
          </div>
          <div class="site">
            <div class="code">
              <div class="code__gutter">
                <span>1</span>
                <span>2</span>
                <span>3</span>
                <span>4</span>
              </div>
              <div class="code__lines">
                <span class="code__line code__line--1">
                  <em>&lt;h1&gt;</em>Hello.<em>&lt;/h1&gt;</em>
                </span>
                <span class="code__line code__line--2">
                  <em>&lt;p&gt;</em>We build<em>&lt;/p&gt;</em>
                </span>
                <span class="code__line code__line--3">
                  <em>&lt;a </em>
                  <strong>class</strong>=<q>btn</q>
                  <em>&gt;</em>
                </span>
                <span class="code__line code__line--4">
                  <em>&lt;img </em>
                  <strong>src</strong>=<q>…</q>
                  <em>&gt;</em>
                </span>
              </div>
            </div>
            <div class="page">
              <p class="page__h1">
                Hello<span>.</span>
              </p>
              <p class="page__p">We build websites end to end, from the first idea to launch.</p>
              <span class="page__btn">Start →</span>
              <span class="page__img" />
            </div>
          </div>
        </>
      )
    }

    {
      kind === 'app' && (
        <>
          <div class="stat">
            <span class="stat__label">Revenue</span>
            <span class="stat__chip">↑ 18%</span>
          </div>
          <div class="stat__num" />
          <div class="chart">
            <svg viewBox="0 0 100 50" preserveAspectRatio="none">
              <path class="chart__grid" d="M0 12.5H100M0 25H100M0 37.5H100" />
            </svg>
            <div class="chart__draw">
              <svg viewBox="0 0 100 50" preserveAspectRatio="none">
                <path class="chart__area" d={AREA} />
                <path class="chart__line" d={LINE} />
              </svg>
            </div>
            <span class="chart__point" />
            <span class="chart__tip">$2,480</span>
          </div>
          <div class="chart__axis">
            <span>Jan</span>
            <span>Apr</span>
            <span>Aug</span>
          </div>
        </>
      )
    }

    {
      kind === 'store' && (
        <>
          <div class="bar bar--shop">
            <span class="bar__url">shop</span>
            <span class="cart">
              <svg viewBox="0 0 24 24">
                <path d="M3 4h3l2.4 11h10.2L21 7H7" />
                <path d="M9.5 19.5h1M16.5 19.5h1" />
              </svg>
              <span class="cart__badge" />
            </span>
          </div>
          <div class="product">
            <div class="product__shot">
              <svg viewBox="0 0 40 40">
                <path d="M9 15h22l-2 19H11z" />
                <path d="M15 15v-3.5a5 5 0 0 1 10 0V15" />
              </svg>
            </div>
            <div class="product__info">
              <span class="product__name">Canvas tote</span>
              <span class="product__price">$48.00</span>
              <span class="sizes">
                <i>S</i>
                <i class="sizes__on">M</i>
                <i>L</i>
              </span>
              <span class="product__add">Add to cart</span>
            </div>
          </div>
          <span class="toast">✓ Added to cart</span>
          <svg class="pointer" viewBox="0 0 24 24">
            <path d="M5 3l14 8-6 1.5L10 19z" />
          </svg>
        </>
      )
    }

    {
      kind === 'brand' && (
        <>
          <div class="guides">
            <span class="guide guide--cap">cap height</span>
            <span class="guide guide--base">baseline</span>
          </div>
          <div class="mark">
            <span class="mark__set">
              <span class="mark__word">Rasf</span>
              <span class="mark__dot" />
              <span class="select">
                <i />
                <i />
                <i />
                <i />
              </span>
            </span>
          </div>
          <div class="swatches">
            <span class="swatch swatch--ink" style="--i: 0">
              Ink
            </span>
            <span class="swatch swatch--accent" style="--i: 1">
              Blue
            </span>
            <span class="swatch swatch--stone" style="--i: 2">
              Stone
            </span>
            <span class="swatch swatch--paper" style="--i: 3">
              Paper
            </span>
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  /* ---- The screen ----------------------------------------------------- */

  .ui {
    /* A picture of an interface, not text: same composition in Arabic. */
    direction: ltr;
    container-type: inline-size;
    inline-size: 100%;
    max-inline-size: 20rem;
    justify-self: center;

    /* One loop for every part of a screen, so they stay in step. */
    --loop: 9s;
    --soft: color-mix(in srgb, var(--ink) 12%, transparent);
    --wash: color-mix(in srgb, var(--ink) 4%, transparent);
  }

  .ui[data-reveal] {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .ui__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--soft);
    background: var(--paper);
    /* A long, soft shadow: a screen resting just above the card. */
    box-shadow:
      0 1px 0 var(--soft),
      0 24px 40px -28px rgb(24 24 28 / 0.45);
    /* Everything inside is sized in em off this, so it scales as one. */
    font-size: 5.2cqi;
    font-family: var(--font-mono);
    color: var(--ink);
    line-height: 1;
    transition:
      translate var(--dur-hover-out) var(--ease-out-expo),
      box-shadow var(--dur-hover-out) var(--ease-out-expo);
  }

  /* Lifts a little when its card is hovered. */
  :global(.card__sheet:hover) .ui__frame {
    translate: 0 -0.35rem;
    box-shadow:
      0 1px 0 var(--soft),
      0 34px 50px -30px rgb(24 24 28 / 0.5);
    transition-duration: var(--dur-hover-in);
  }

  .ui__frame * {
    animation-duration: var(--loop);
    animation-iteration-count: infinite;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    /* Parts with a stagger delay hold their first frame while they wait. */
    animation-fill-mode: backwards;
  }

  /* Waits at its first frame until it is in view. */
  .ui[data-reveal]:not(:global(.is-revealed)) * {
    animation-play-state: paused;
  }

  /* Nothing to start it, or motion reduced: the finished screen, still. */
  :global(.no-js) .ui__frame *,
  :global(.no-js) .ui__frame *::after {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ui .ui__frame *,
    .ui .ui__frame *::after {
      animation: none !important;
    }
  }

  /* A browser's top bar, shared by the website and the shop. */
  .bar {
    display: flex;
    align-items: center;
    gap: 0.28em;
    block-size: 1.7em;
    padding-inline: 0.6em;
    border-block-end: 1px solid var(--soft);
    background: var(--paper-sunk);
  }

  .bar i {
    inline-size: 0.38em;
    block-size: 0.38em;
    background: var(--soft);
  }

  .bar__url {
    flex: 1;
    max-inline-size: 7.5em;
    margin-inline-start: 0.5em;
    padding: 0.22em 0.55em;
    font-size: 0.58em;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    background: var(--paper);
    border: 1px solid var(--soft);
  }

  /* ---- Website: an editor beside the page it makes ------------------- */

  .site {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    block-size: calc(100% - 1.7em);
  }

  .code {
    display: flex;
    gap: 0.6em;
    padding: 0.85em 0.55em;
    font-size: 0.56em;
    line-height: 1;
    background: var(--ink);
    color: var(--paper);
  }

  .code__gutter,
  .code__lines {
    display: flex;
    flex-direction: column;
    gap: 1.05em;
  }

  .code__gutter {
    color: color-mix(in srgb, var(--paper) 30%, transparent);
  }

  .code__line {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    inline-size: var(--n);
    /* The caret: rides on the end of whichever line is being typed. */
    border-inline-end: 0.12em solid transparent;
  }

  /* Tags are quiet; attribute names and values pick up the accent. */
  .code__line em {
    font-style: normal;
    color: color-mix(in srgb, var(--paper) 45%, transparent);
  }

  .code__line strong {
    font-weight: 400;
    color: #8fa6ef;
  }

  .code__line q {
    quotes: '"' '"';
    color: color-mix(in srgb, var(--paper) 85%, transparent);
  }

  .code__line--1 {
    --n: 15.2ch;
    animation-name: type-1;
  }

  .code__line--2 {
    --n: 16.2ch;
    animation-name: type-2;
  }

  .code__line--3 {
    --n: 15.2ch;
    animation-name: type-3;
  }

  .code__line--4 {
    --n: 14.2ch;
    animation-name: type-4;
  }

  /* Each line types in its own slot of the loop, holds, then clears. */
  @keyframes type-1 {
    0%,
    3.5% {
      inline-size: 0;
      border-color: transparent;
    }
    4% {
      inline-size: 0;
      border-color: #8fa6ef;
      animation-timing-function: steps(15, end);
    }
    16% {
      inline-size: var(--n);
      border-color: #8fa6ef;
    }
    17%,
    90% {
      inline-size: var(--n);
      border-color: transparent;
    }
    95%,
    100% {
      inline-size: 0;
    }
  }

  @keyframes type-2 {
    0%,
    19.5% {
      inline-size: 0;
      border-color: transparent;
    }
    20% {
      inline-size: 0;
      border-color: #8fa6ef;
      animation-timing-function: steps(16, end);
    }
    33% {
      inline-size: var(--n);
      border-color: #8fa6ef;
    }
    34%,
    90% {
      inline-size: var(--n);
      border-color: transparent;
    }
    95%,
    100% {
      inline-size: 0;
    }
  }

  @keyframes type-3 {
    0%,
    36.5% {
      inline-size: 0;
      border-color: transparent;
    }
    37% {
      inline-size: 0;
      border-color: #8fa6ef;
      animation-timing-function: steps(15, end);
    }
    50% {
      inline-size: var(--n);
      border-color: #8fa6ef;
    }
    51%,
    90% {
      inline-size: var(--n);
      border-color: transparent;
    }
    95%,
    100% {
      inline-size: 0;
    }
  }

  @keyframes type-4 {
    0%,
    53.5% {
      inline-size: 0;
      border-color: transparent;
    }
    54% {
      inline-size: 0;
      border-color: #8fa6ef;
      animation-timing-function: steps(14, end);
    }
    66% {
      inline-size: var(--n);
      border-color: #8fa6ef;
    }
    67%,
    90% {
      inline-size: var(--n);
      border-color: transparent;
    }
    95%,
    100% {
      inline-size: 0;
    }
  }

  .page {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45em;
    padding: 0.75em 0.7em;
  }

  .page__h1 {
    font-family: var(--font-display-en);
    font-size: 1.55em;
    letter-spacing: -0.04em;
    line-height: 0.9;
    animation-name: land-1;
  }

  .page__h1 span {
    color: var(--accent);
  }

  .page__p {
    font-family: var(--font-display-en);
    font-size: 0.48em;
    line-height: 1.4;
    color: var(--ink-muted);
    animation-name: land-2;
  }

  .page__btn {
    padding: 0.42em 0.7em;
    font-family: var(--font-display-en);
    font-size: 0.5em;
    color: var(--paper);
    background: var(--accent);
    animation-name: land-3;
  }

  /* A picture slot, hatched like a placeholder on a plan. */
  .page__img {
    align-self: stretch;
    flex: 1;
    margin-block-start: 0.2em;
    border: 1px solid var(--soft);
    background: repeating-linear-gradient(-45deg, var(--wash) 0 0.18em, transparent 0.18em 0.5em), var(--paper-sunk);
    animation-name: land-4;
  }

  /* Each block fades up into place as its line finishes typing. */
  @keyframes land-1 {
    0%,
    16% {
      opacity: 0;
      translate: 0 0.5em;
    }
    24%,
    90% {
      opacity: 1;
      translate: 0 0;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  @keyframes land-2 {
    0%,
    33% {
      opacity: 0;
      translate: 0 0.5em;
    }
    41%,
    90% {
      opacity: 1;
      translate: 0 0;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  @keyframes land-3 {
    0%,
    50% {
      opacity: 0;
      translate: 0 0.5em;
    }
    58%,
    90% {
      opacity: 1;
      translate: 0 0;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  @keyframes land-4 {
    0%,
    66% {
      opacity: 0;
      translate: 0 0.5em;
    }
    74%,
    90% {
      opacity: 1;
      translate: 0 0;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  /* ---- App: revenue over a chart that draws itself ------------------- */

  /* Typed, so the browser can count it up in whole numbers. */
  @property --revenue {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  .stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75em 0.75em 0;
  }

  .stat__label {
    font-size: 0.55em;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .stat__chip {
    padding: 0.25em 0.45em;
    font-size: 0.55em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    animation-name: chip;
  }

  @keyframes chip {
    0%,
    44% {
      opacity: 0;
      translate: 0 -0.4em;
    }
    52%,
    90% {
      opacity: 1;
      translate: 0 0;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  .stat__num {
    --revenue: 2480;
    padding: 0.3em 0.42em 0;
    counter-reset: revenue var(--revenue);
    font-family: var(--font-display-en);
    font-size: 1.85em;
    letter-spacing: -0.04em;
    animation-name: count;
  }

  .stat__num::after {
    content: '$' counter(revenue);
  }

  @keyframes count {
    0%,
    6% {
      --revenue: 0;
    }
    46%,
    90% {
      --revenue: 2480;
    }
    96%,
    100% {
      --revenue: 0;
    }
  }

  .chart {
    position: absolute;
    inset: 40% 0.75em 2.1em;
  }

  .chart svg {
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .chart__grid {
    fill: none;
    stroke: var(--soft);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    vector-effect: non-scaling-stroke;
  }

  .chart__line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* The data, revealed left to right as if drawn: a clip, because dash
     tricks on a non-scaling stroke count in screen pixels, not the path. */
  .chart__draw {
    position: absolute;
    inset: 0;
    animation-name: draw-line;
  }

  .chart__area {
    fill: color-mix(in srgb, var(--accent) 12%, transparent);
    animation-name: fill-area;
  }

  @keyframes draw-line {
    0%,
    6% {
      clip-path: inset(-10% 100% -10% 0);
    }
    46%,
    90% {
      clip-path: inset(-10% 0 -10% 0);
    }
    96%,
    100% {
      clip-path: inset(-10% 0 -10% 100%);
    }
  }

  @keyframes fill-area {
    0%,
    30% {
      opacity: 0;
    }
    50%,
    90% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  /* The last point, marked, with its value above it. */
  .chart__point {
    position: absolute;
    inset-inline-start: 96%;
    inset-block-start: 18%;
    inline-size: 0.5em;
    block-size: 0.5em;
    translate: -50% -50%;
    background: var(--accent);
    outline: 0.18em solid color-mix(in srgb, var(--accent) 22%, transparent);
    animation-name: point-in;
  }

  .chart__tip {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: -18%;
    padding: 0.35em 0.5em;
    font-size: 0.55em;
    color: var(--paper);
    background: var(--ink);
    animation-name: point-in;
  }

  @keyframes point-in {
    0%,
    46% {
      opacity: 0;
      scale: 0.6;
    }
    54%,
    90% {
      opacity: 1;
      scale: 1;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  .chart__axis {
    position: absolute;
    inset: auto 0.75em 0.7em;
    display: flex;
    justify-content: space-between;
    font-size: 0.48em;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }

  /* ---- Store: pick a size, add to cart, twice ------------------------ */

  @property --qty {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  .bar--shop {
    justify-content: space-between;
  }

  .bar--shop .bar__url {
    margin: 0;
  }

  .cart {
    position: relative;
    display: block;
    inline-size: 1.05em;
    block-size: 1.05em;
  }

  .cart svg,
  .product__shot svg {
    inline-size: 100%;
    block-size: 100%;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .cart__badge {
    --qty: 2;
    position: absolute;
    inset-block-start: -0.4em;
    inset-inline-end: -0.5em;
    display: grid;
    place-items: center;
    inline-size: 0.85em;
    block-size: 0.85em;
    counter-reset: qty var(--qty);
    color: var(--paper);
    background: var(--accent);
    animation-name: qty;
    animation-timing-function: linear;
  }

  .cart__badge::after {
    content: counter(qty);
    font-size: 0.6em;
  }

  /* Ticks up on each click, with a little bump. */
  @keyframes qty {
    0%,
    43% {
      --qty: 0;
      scale: 0;
    }
    44% {
      --qty: 1;
      scale: 1.35;
    }
    48%,
    68% {
      --qty: 1;
      scale: 1;
    }
    69% {
      --qty: 2;
      scale: 1.35;
    }
    73%,
    90% {
      --qty: 2;
      scale: 1;
    }
    95%,
    100% {
      --qty: 0;
      scale: 0;
    }
  }

  .product {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 0.75em;
    padding: 0.75em;
    block-size: calc(100% - 1.7em);
  }

  .product__shot {
    display: grid;
    place-items: center;
    padding: 20%;
    background: color-mix(in srgb, var(--accent) 7%, var(--paper-sunk));
  }

  .product__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4em;
  }

  .product__name {
    font-family: var(--font-display-en);
    font-size: 0.85em;
    letter-spacing: -0.02em;
  }

  .product__price {
    font-size: 0.55em;
    color: var(--ink-muted);
  }

  .sizes {
    display: flex;
    gap: 0.25em;
    margin-block-start: 0.2em;
  }

  .sizes i {
    display: grid;
    place-items: center;
    inline-size: 1.15em;
    block-size: 1.15em;
    font-size: 0.5em;
    font-style: normal;
    border: 1px solid var(--soft);
  }

  .sizes__on {
    color: var(--paper);
    background: var(--ink);
    animation-name: pick;
  }

  /* Chosen by the pointer on its way to the button. */
  @keyframes pick {
    0%,
    26% {
      color: var(--ink);
      background: transparent;
    }
    28%,
    100% {
      color: var(--paper);
      background: var(--ink);
    }
  }

  .product__add {
    align-self: stretch;
    margin-block-start: auto;
    padding: 0.6em 0.3em;
