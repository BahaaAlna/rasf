---
/*
  What every page shows while the site is in maintenance mode, in place
  of its header, content and footer (see BaseLayout).

  It opens with the name, coming into focus: the logotype as drawn, its
  dot already in place, rising a little out of a soft blur. Then the
  note: that we'll be back, and the email for anything that can't wait.
  A way to the same note in the other language, and nothing else.

  The whole entrance is CSS: it plays without JavaScript, and with
  reduced motion everything is simply there.
*/
import { getImage } from 'astro:assets';
import logoAr from '../../assets/logo-ar.png';
import logoEn from '../../assets/logo-en.png';
import { getMaintenance, getSite, getUI } from '../../lib/content';
import { localizePath, otherLocale, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const ui = getUI(locale);
const note = getMaintenance(locale);
const other = otherLocale(locale);

const logo = await getImage({ src: locale === 'ar' ? logoAr : logoEn, format: 'webp', width: 960 });

// The closing full stop takes the accent, as it does across the site.
const title = note.title.trim();
const stop = title.endsWith('.');
const titleText = stop ? title.slice(0, -1) : title;
---

<main id="main" class="pause u-wrap">
  <header class="pause__bar">
    <a class="pause__switch u-mono" href={localizePath('/', other)} hreflang={other} lang={other}>{ui.switchTo}</a>
  </header>

  <div class="pause__body">
    <img
      class="pause__name"
      data-locale={locale}
      src={logo.src}
      width={logo.attributes.width}
      height={logo.attributes.height}
      alt={site.name}
      decoding="async"
    />

    <div class="pause__words">
      <h1 class="pause__title">
        {titleText}{stop && <span class="pause__dot">.</span>}
      </h1>
      <p class="pause__message">{note.message}</p>
      {
        site.email && (
          <p class="pause__reach">
            {note.reach}{' '}
            <a href={`mailto:${site.email}`} dir="ltr">
              {site.email}
            </a>
          </p>
        )
      }
    </div>
  </div>
</main>

<style>
  .pause {
    display: grid;
    grid-template-rows: auto 1fr;
    min-block-size: 100svh;
    padding-block: var(--space-lg);
  }

  .pause__bar {
    display: flex;
    justify-content: flex-end;
  }

  .pause__switch {
    padding: var(--space-2xs) var(--space-md);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    transition:
      background var(--dur-base) var(--ease-out-power4),
      color var(--dur-base) var(--ease-out-power4);
  }

  .pause__switch:hover,
  .pause__switch:focus-visible {
    color: var(--paper);
    background: var(--ink);
  }

  .pause__body {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
    text-align: center;
  }

  /* ---- The name, coming into focus --------------------------------- */

  .pause__name {
    display: block;
    inline-size: min(26rem, 68vw);
    block-size: auto;
  }

  /* The Arabic logotype is longer and lower; the same width reads smaller. */
  .pause__name[data-locale='ar'] {
    inline-size: min(30rem, 76vw);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pause__name {
      animation: focus 1.6s var(--ease-out-expo) 0.15s both;
    }

    .pause__title,
    .pause__message,
    .pause__reach,
    .pause__bar {
      animation: rise var(--dur-reveal) var(--ease-out-power4) both;
    }

    .pause__title {
      animation-delay: 0.9s;
    }

    .pause__message {
      animation-delay: 1.05s;
    }

    .pause__reach {
      animation-delay: 1.2s;
    }

    .pause__bar {
      animation-delay: 1.5s;
    }
  }

  @keyframes focus {
    from {
      opacity: 0;
      filter: blur(14px);
      transform: translateY(0.75rem) scale(0.985);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  /* ---- The note ----------------------------------------------------- */

  .pause__words {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
  }

  .pause__dot {
    color: var(--accent);
  }

  .pause__title {
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  :global([dir='rtl']) .pause__title {
    line-height: var(--ar-leading);
    letter-spacing: 0;
  }

  .pause__message {
    max-inline-size: 36ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-muted);
  }

  :global([dir='rtl']) .pause__message {
    font-size: calc(var(--step-1) * var(--ar-scale));
    line-height: calc(1.45 * var(--ar-leading));
  }

  .pause__reach {
    color: var(--ink);
  }

  .pause__reach a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.18em;
  }

  .pause__reach a:hover {
    color: var(--accent);
  }
</style>
