---
/*
  While a page is still arriving: the name and the slogan, and under them
  a hairline that fills as it lands. It stays until everything the first
  screen needs is in: the stylesheets and scripts, every picture that's
  on screen (downloaded and decoded), the fonts, and the interactive
  parts awake. Pictures further down are lazy, so they don't hold it up;
  they arrive as the reader scrolls to them.

  On the first page of a visit, one that's ready within half a second (a
  return visit, a fast connection) never shows it at all.

  Every move to another page afterwards shows it too, at once, the moment
  the link is followed: the ClientRouter fetches the next page and swaps
  it in, and without this the old page would just sit there, as if
  frozen, until the new one appeared. It covers the fetch and the swap,
  and lifts only when the new page's first screen is ready, by the same
  measure as the first load. A jump within the same page (#contact) isn't
  a move and doesn't show it.

  It never stays longer than 30 seconds whatever happens, and without
  JavaScript it never appears, so nothing is stuck behind it.

  The picture is drawn as the site builds (lib/og.ts), so the screen
  needs nothing that's still loading.
*/
import type { Locale } from '../../lib/i18n';
import { LOADER } from '../../lib/og';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<script is:inline>
  if (!window.__rasfLoaded) document.documentElement.classList.add('is-loading');
</script>

<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__inner">
    <img
      class="loader__mark"
      src={`/loader/${locale}.png`}
      width={LOADER.width / 2}
      height={LOADER.height / 2}
      alt=""
      fetchpriority="high"
    />
    <span class="loader__track"><span class="loader__fill" id="loader-fill"></span></span>
  </div>
</div>

<script is:inline>
  // The ClientRouter runs an inline script once per visit (the same text
  // on the next page is skipped), so this sets everything up once and
  // looks the screen up afresh each time: every page brings its own.
  (() => {
    const root = document.documentElement;
    const screen = () => document.getElementById('loader');
    const fill = () => document.getElementById('loader-fill');

    /** Which wait is current: a newer move to another page outdates the one before. */
    let run = 0;
    /** Between following a link and the new page being in place. */
    let moving = false;
    let shown = 0;

    // Only ever moves forward, until the next page starts it again.
    const show = (part) => {
      shown = Math.max(shown, Math.min(part, 1));
      const bar = fill();
      if (bar) bar.style.transform = `scaleX(${shown})`;
    };

    /** Back to empty at once, not drawn back across. */
    const empty = () => {
      shown = 0;
      const bar = fill();
      if (!bar) return;
      bar.style.transition = 'none';
      bar.style.transform = 'scaleX(0)';
      void bar.offsetWidth;
      bar.style.removeProperty('transition');
    };

    const wait = (ms) => new Promise((r) => setTimeout(r, ms));
    const frames = () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

    // On screen: laid out, and inside the first screenful. A lazy picture
    // further down waits for the reader; one that's hidden never loads.
    const onScreen = (img) => {
      if (!img.getClientRects().length) return false;
      const box = img.getBoundingClientRect();
      return box.bottom > 0 && box.top < innerHeight && box.right > 0 && box.left < innerWidth;
    };

    // Each picture that counts: downloaded, then decoded, so it paints whole.
    const pictures = (from, to) => {
      const images = [...document.images].filter(
        (img) => !img.closest('#loader') && (img.loading !== 'lazy' || onScreen(img)),
      );
      let landed = 0;
      const one = () => show(from + ((to - from) * ++landed) / Math.max(images.length, 1));
      return Promise.all(
        images.map((img) =>
          (img.complete
            ? Promise.resolve()
            : new Promise((r) => {
                img.addEventListener('load', r, { once: true });
                img.addEventListener('error', r, { once: true });
              })
          )
            .then(() => (img.naturalWidth ? img.decode() : null))
            .catch(() => null)
            .then(one),
        ),
      );
    };

    // Every font the page has started on, then whatever its text still needs.
    const fonts = () =>
      document.fonts
        ? Promise.all([...document.fonts].filter((f) => f.status === 'loading').map((f) => f.loaded.catch(() => null))).then(
            () => document.fonts.ready,
          )
        : null;

    // The interactive parts: Astro drops `ssr` from an island once it's awake.
    // Islands that wake on sight are left to wake when they're seen.
    const awake = async () => {
      const asleep = () =>
        [...document.querySelectorAll('astro-island[ssr]')].some((island) => {
          const when = island.getAttribute('client');
          return when === 'load' || when === 'idle';
        });
      for (let i = 0; i < 100 && asleep(); i++) await wait(100);
    };

    /** The screen lifts, unless a newer move has started since. */
    const lift = (id, quick) => {
      if (id !== run) return;
      window.__rasfLoaded = true;
      // The page's own entrance plays as the screen lifts, not behind it.
      root.classList.add('is-ready');
      const done = () => {
        if (id === run) root.classList.remove('is-loading', 'is-moving', 'is-ready');
      };
      // Ready before it was ever shown: gone at once, with no fade to glimpse.
      if (quick) return done();
      show(1);
      screen()?.classList.add('loader--out');
      setTimeout(done, 520);
    };

    /** Until this page's first screen is ready, then lift. */
    const settle = (id, first) => {
      const start = performance.now();
      const loaded = first
        ? new Promise((r) => (document.readyState === 'complete' ? r() : addEventListener('load', r, { once: true })))
        : null;
      const parsed = new Promise((r) =>
        document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', r, { once: true }) : r(),
      );
      const ready = () => lift(id, first && performance.now() - start < 450);

      Promise.all([parsed.then(() => pictures(first ? 0.1 : 0.5, 0.7)), loaded?.then(() => show(0.8))])
        .then(fonts)
        .then(() => show(0.9))
        .then(awake)
        // One frame for everything to paint before it's revealed.
        .then(frames)
        .then(ready, ready);
      setTimeout(ready, 30000);
    };

    // The first page of the visit.
    show(0.05);
    settle(run, true);

    // A link followed: cover the page now, before the next one is fetched.
    document.addEventListener('astro:before-preparation', () => {
      run++;
      moving = true;
      root.classList.remove('is-ready');
      root.classList.add('is-loading', 'is-moving');
      screen()?.classList.remove('loader--out', 'loader--held');
      empty();
      show(0.1);
    });

    // Fetched, with its stylesheets.
    document.addEventListener('astro:after-preparation', () => show(0.4));

    // The new page replaces the root's classes and the screen itself, so
    // it arrives already covered, the hairline where this one had it.
    document.addEventListener('astro:before-swap', (event) => {
      event.newDocument.documentElement.classList.add('is-loading', 'is-moving');
      // Already covering: no fade in, which would show the new page through it.
      event.newDocument.getElementById('loader')?.classList.add('loader--held');
      const bar = event.newDocument.getElementById('loader-fill');
      if (bar) bar.setAttribute('style', `transition: none; transform: scaleX(${shown})`);
    });

    // In place, with its scripts run: now wait for it the way the first page was waited for.
    document.addEventListener('astro:page-load', () => {
      if (!moving) return;
      moving = false;
      const bar = fill();
      if (bar) requestAnimationFrame(() => bar.style.removeProperty('transition'));
      settle(run, false);
    });
  })();
</script>

<style>
  .loader {
    display: none;
  }

  :global(html.is-loading) {
    overflow: hidden;
  }

  /* The page's own entrances hold their first frame until the screen lifts. */
  :global(html.is-loading:not(.is-ready) body > :not(.loader)),
  :global(html.is-loading:not(.is-ready) body > :not(.loader) *) {
    animation-play-state: paused !important;
  }

  :global(html.is-loading) .loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--paper);
    transition:
      opacity 0.5s var(--ease-out-power3),
      visibility 0s linear 0.5s;
  }

  .loader.loader--out {
    visibility: hidden;
    opacity: 0;
  }

  /* Held back nearly half a second: a page that's ready by then never shows it. */
  .loader__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    opacity: 0;
    animation: loader-in 0.6s var(--ease-out-expo) 0.45s forwards;
  }

  /* Moving to another page: it covers the old one at once, and the name shows straight away. */
  :global(html.is-moving) .loader:not(.loader--out, .loader--held) {
    animation: loader-cover 0.2s var(--ease-out-power3);
  }

  :global(html.is-moving) .loader__inner {
    opacity: 1;
    animation: none;
  }

  .loader__mark {
    display: block;
    inline-size: min(320px, 72vw);
    block-size: auto;
  }

  .loader__track {
    display: block;
    inline-size: min(9rem, 40vw);
    block-size: 1px;
    overflow: hidden;
    background: var(--rule);
  }

  /* The hairline fills from the side the language starts on. */
  .loader__fill {
    display: block;
    block-size: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out-power3);
  }

  :global([dir='rtl']) .loader__fill {
    transform-origin: right;
  }

  @keyframes loader-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes loader-cover {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader__inner {
      animation-duration: 0.01ms;
    }

    :global(html.is-moving) .loader {
      animation: none;
    }

    .loader__fill {
      transition: none;
    }
  }
</style>
