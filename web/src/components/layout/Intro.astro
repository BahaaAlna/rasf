---
/*
  The logo film, once per visit: the dot arrives, lands, and "Rasf."
  forms; then the screen fades away into the page. It plays on the first
  page of a visit only (sessionStorage), never for people who've asked
  their device for less motion, and it gives way at once to a tap, a key,
  or a video that won't play (a phone saving battery may refuse
  autoplay). Without JavaScript it never appears, so nothing is ever
  stuck behind it.

  The film is the first four seconds of the original: the logo is whole
  by then. WebM (light) for most browsers; the original MP4 for Safari,
  stopped at the same moment. The screen is the film's own paper colour,
  a shade off the site's, so no edge shows around it.
*/
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<script is:inline>
  // Decided before anything below is drawn, so the page never flashes first.
  (() => {
    try {
      if (sessionStorage.getItem('rasf-intro')) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (navigator.webdriver) return;
      document.documentElement.classList.add('has-intro');
    } catch {
      /* No storage (a private window, say): skip the film rather than show it every page. */
    }
  })();
</script>

<div class="intro" id="intro" aria-hidden="true">
  <video class="intro__film" muted playsinline disablepictureinpicture preload="none"></video>
  <button class="intro__skip" type="button" tabindex="-1">{locale === 'ar' ? 'تخطَّ' : 'Skip'}</button>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const screen = document.getElementById('intro');
    if (!root.classList.contains('has-intro') || !screen) {
      screen?.remove();
      return;
    }
    try {
      sessionStorage.setItem('rasf-intro', '1');
    } catch {}

    const film = screen.querySelector('video');
    const END = 3.9;
    let over = false;

    const finish = () => {
      if (over) return;
      over = true;
      screen.classList.add('intro--out');
      setTimeout(() => {
        root.classList.remove('has-intro');
        film.pause();
        screen.remove();
      }, 650);
    };

    // The light WebM where it plays; the original MP4 (Safari) otherwise.
    const webm = film.canPlayType('video/webm; codecs="vp9"');
    film.src = webm ? '/intro/intro.webm' : '/intro/intro.mp4';
    film.addEventListener('timeupdate', () => film.currentTime >= END && finish());
    film.addEventListener('ended', finish);
    film.addEventListener('error', finish);
    film.play().catch(finish);

    screen.addEventListener('pointerdown', finish);
    window.addEventListener('keydown', finish, { once: true });
    // Whatever happens, never longer than this.
    setTimeout(finish, 6000);
  })();
</script>

<style>
  .intro {
    display: none;
  }

  :global(html.has-intro) {
    overflow: hidden;
  }

  :global(html.has-intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #efeadc;
    transition:
      opacity 0.6s var(--ease-out-power3),
      visibility 0s linear 0.6s;
  }

  .intro.intro--out {
    visibility: hidden;
    opacity: 0;
  }

  /*
    Wide screens: the whole frame, filling the screen. Centred by its own
    middle, not by the grid: a film wider than the screen would otherwise
    hang from the page's starting side, the right one in Arabic.
  */
  .intro__film {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    inline-size: 100vw;
    block-size: 100svh;
    object-fit: cover;
  }

  /*
    Tall screens: covering would cut the sides off, and the word with
    them. Wider than the screen instead, so its middle, where the dot
    moves and the word forms, fills most of it.
  */
  @media (max-aspect-ratio: 1/1) {
    .intro__film {
      inline-size: 230vw;
      max-inline-size: none;
      block-size: auto;
      object-fit: initial;
    }
  }

  .intro__skip {
    position: absolute;
    inset-block-end: max(var(--space-lg), env(safe-area-inset-bottom));
    inset-inline: 0;
    margin-inline: auto;
    inline-size: max-content;
    padding: var(--space-2xs) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
</style>
