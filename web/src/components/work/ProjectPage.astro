---
/*
  One project's own page, /work/<slug>, once for both languages.

  The way back to its kind (Software or Designs), the name set large with
  the accent dot, what it was and when, the summary, then its picture,
  wide. From the picture a thin line drops into the text and ends in the
  dot, the same line that joins picture and words on the Software and
  Designs pages. Beside the explanation, a column of facts: kind, year,
  what we did, and a way to the live thing when there is one. Any more
  pictures follow, then the next project of the same kind.

  The language switch goes to the same project in the other language
  when it exists there, and to that language's Software or Designs page
  when it doesn't.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../layout/Header/SiteHeader.astro';
import PageFoot from '../blog/PageFoot.astro';
import { getUI, getWork } from '../../lib/content';
import { localizePath, otherLocale, type Locale } from '../../lib/i18n';
import { textToHtml } from '../../lib/text';
import type { WorkProject } from '../../data/work';

interface Props {
  locale: Locale;
  project: WorkProject;
}

const { locale, project } = Astro.props;
const ui = getUI(locale);
const work = getWork(locale);
const words = work.project;

const kindPath = project.category === 'design' ? '/work/designs' : '/work/software';
const kindTitle = project.category === 'design' ? ui.workPages.designs : ui.workPages.software;
const path = `/work/${project.slug}`;

const translated = getWork(otherLocale(locale)).projects.some((p) => p.slug === project.slug);
const switchHref = localizePath(translated ? path : kindPath, otherLocale(locale));

// The next project of the same kind, round to the first after the last.
const sameKind = work.projects.filter((p) => p.category === project.category);
// By slug: each getWork() makes fresh objects, so `project` itself isn't in the list.
const here = sameKind.findIndex((p) => p.slug === project.slug);
const next = sameKind.length > 1 ? sameKind[(here + 1) % sameKind.length] : null;

const scope = project.scope?.filter(Boolean) ?? [];
const gallery = project.gallery?.filter(Boolean) ?? [];
---

<BaseLayout path={path} title={project.name} description={project.summary} translated={translated} ogType="article">
  <SiteHeader slot="header" locale={locale} switchHref={switchHref} />

  <article class="project">
    <header class="project__head u-wrap">
      <a class="project__up u-mono" href={localizePath(kindPath, locale)}>
        <svg class="u-flip" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 12H5M11 6l-6 6 6 6"></path>
        </svg>
        {kindTitle}
      </a>
      <h1 class="project__name" data-reveal>
        {project.name}<span class="project__dot">.</span>
      </h1>
      <p class="project__meta u-mono" data-reveal style="--reveal-delay: 0.06s">
        {project.kind} · {project.year}
      </p>
      {
        project.summary && (
          <p class="project__summary" data-reveal style="--reveal-delay: 0.1s">
            {project.summary}
          </p>
        )
      }
    </header>

    <figure class="project__hero u-wrap" data-reveal>
      <span class="project__pic">
        <img src={project.image} alt={project.name} width="1600" height="1000" decoding="async" />
      </span>
    </figure>

    <div class="project__body u-wrap">
      <aside class="facts" data-reveal>
        <span class="facts__line" aria-hidden="true"></span>
        <dl>
          <div class="facts__row">
            <dt class="u-mono">{words.kind}</dt>
            <dd>{project.kind}</dd>
          </div>
          <div class="facts__row">
            <dt class="u-mono">{words.year}</dt>
            <dd>{project.year}</dd>
          </div>
          {
            scope.length > 0 && (
              <div class="facts__row">
                <dt class="u-mono">{words.scope}</dt>
                <dd>
                  <ul class="facts__scope">
                    {scope.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
        {
          project.link && (
            <a class="facts__visit" href={project.link} target="_blank" rel="noopener" data-weightless>
              <span class="facts__visit-label" data-weightless-label>
                {words.visit}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8"></path>
                </svg>
              </span>
            </a>
          )
        }
      </aside>

      <div class="prose" set:html={textToHtml(project.body ?? '')} />
    </div>

    {
      gallery.length > 0 && (
        <div class="gallery u-wrap">
          {gallery.map((src, i) => (
            <span class="gallery__pic" data-reveal style={`--reveal-delay: ${0.05 * (i % 2)}s`}>
              <img src={src} alt="" loading="lazy" decoding="async" />
            </span>
          ))}
        </div>
      )
    }

    {
      next && (
        <nav class="next u-wrap" aria-label={words.next}>
          <a class="next__link" href={localizePath(`/work/${next.slug}`, locale)}>
            <span class="next__label u-mono">{words.next}</span>
            <span class="next__name">{next.name}</span>
            <svg class="next__go u-flip" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h15M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </nav>
      )
    }
  </article>

  <PageFoot slot="footer" locale={locale} />
</BaseLayout>

<style>
  /* ---- The head ------------------------------------------------------- */

  .project__head {
    padding-block-start: var(--space-xl);
  }

  .project__up {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--ink);
    transition: color var(--dur-base) var(--ease-out-power3);
  }

  .project__up:hover,
  .project__up:focus-visible {
    color: var(--accent);
  }

  .project__up svg {
    inline-size: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .project__name {
    margin-block-start: var(--space-2xl);
    font-size: var(--step-5);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  :global([dir='rtl']) .project__name {
    font-size: calc(var(--step-5) * 0.95);
    line-height: var(--ar-leading);
    letter-spacing: 0;
  }

  .project__dot {
    color: var(--accent);
  }

  .project__meta {
    margin-block-start: var(--space-lg);
  }

  .project__summary {
    max-inline-size: 40ch;
    margin-block-start: var(--space-md);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-muted);
  }

  :global([dir='rtl']) .project__summary {
    font-size: calc(var(--step-1) * var(--ar-scale));
    line-height: calc(1.45 * var(--ar-leading));
  }

  /* ---- The picture ---------------------------------------------------- */

  .project__hero {
    margin-block-start: var(--space-2xl);
  }

  .project__pic {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--paper-sunk);
  }

  .project__pic img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* ---- The facts and the text ----------------------------------------- */

  .project__body {
    display: grid;
    gap: var(--space-xl) var(--space-2xl);
    padding-block-start: var(--space-2xl);
  }

  @media (min-width: 56rem) {
    .project__body {
      grid-template-columns: 4fr 8fr;
      align-items: start;
    }

    .facts {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-lg));
    }
  }

  .facts {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  /*
    The line from the picture: it drops through the gap above and ends in
    the dot, beside the first fact. It draws down as the facts come into
    view, as the lines on the Software and Designs pages draw across.
  */
  .facts__line {
    position: absolute;
    inset-block-end: calc(100% - 0.6em);
    inset-inline-start: 0;
    inline-size: 1px;
    block-size: calc(var(--space-2xl) + 0.6em);
    background: var(--ink-muted);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.1s var(--ease-out-expo);
  }

  .facts__line::after {
    content: '';
    position: absolute;
    inset-block-end: -0.3rem;
    left: -0.3rem;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    scale: 0;
    transition: scale var(--dur-base) var(--ease-out-expo);
  }

  .facts:global(.is-revealed) .facts__line {
    transform: none;
  }

  .facts:global(.is-revealed) .facts__line::after {
    scale: 1;
    transition-delay: 0.65s;
  }

  .facts dl {
    display: grid;
    gap: var(--space-md);
    inline-size: 100%;
    padding-inline-start: var(--space-lg);
  }

  .facts__row {
    display: grid;
    gap: var(--space-2xs);
    padding-block-end: var(--space-md);
    border-block-end: 1px solid var(--rule);
  }

  .facts__row dd {
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--ink);
  }

  :global([dir='rtl']) .facts__row dd {
    font-size: calc(var(--step-1) * var(--ar-scale));
    line-height: var(--ar-leading);
  }

  .facts__scope li + li {
    margin-block-start: var(--space-2xs);
  }

  .facts__visit {
    display: inline-block;
    margin-inline-start: var(--space-lg);
    padding: var(--space-sm) var(--space-lg);
    color: var(--paper);
    background: var(--ink);
    border-radius: var(--radius-pill);
    transition: background var(--dur-base) var(--ease-out-power4);
  }

  .facts__visit:hover,
  .facts__visit:focus-visible {
    background: var(--accent);
  }

  .facts__visit-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .facts__visit svg {
    inline-size: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  /* The explanation, set for reading. */
  .prose {
    max-inline-size: var(--measure);
    font-size: calc(var(--step-0) * 1.12);
  }

  :global([dir='rtl']) .prose {
    font-size: calc(var(--step-0) * 1.12 * var(--ar-scale));
  }

  .prose > :global(* + *) {
    margin-block-start: var(--space-md);
  }

  .prose > :global(:first-child) {
    margin-block-start: 0;
  }

  .prose > :global(h2) {
    margin-block-start: var(--space-xl);
    font-size: var(--step-2);
    color: var(--ink);
  }

  .prose > :global(h3) {
    margin-block-start: var(--space-lg);
    font-size: var(--step-1);
    color: var(--ink);
  }

  :global([dir='rtl']) .prose > :global(h2) {
    font-size: calc(var(--step-2) * var(--ar-scale));
  }

  :global([dir='rtl']) .prose > :global(h3) {
    font-size: calc(var(--step-1) * var(--ar-scale));
  }

  .prose :global(ul) {
    padding-inline-start: 1.25em;
    list-style: disc;
  }

  .prose :global(li + li) {
    margin-block-start: var(--space-2xs);
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.18em;
  }

  .prose :global(a:hover) {
    color: var(--accent);
  }

  /* ---- More pictures: two columns, the second set lower -------------- */

  .gallery {
    display: grid;
    gap: var(--space-lg);
    padding-block-start: var(--space-3xl);
  }

  @media (min-width: 56rem) {
    .gallery {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .gallery__pic:nth-child(even) {
      margin-block-start: var(--space-2xl);
    }
  }

  .gallery__pic {
    display: block;
    overflow: hidden;
    background: var(--paper-sunk);
  }

  .gallery__pic img {
    inline-size: 100%;
  }

  /* ---- The next project ------------------------------------------------ */

  .next {
    padding-block-start: var(--space-3xl);
  }

  .next__link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-xs) var(--space-lg);
    padding-block-start: var(--space-md);
    color: var(--ink);
    border-block-start: 1px solid var(--ink);
  }

  .next__label {
    grid-column: 1 / -1;
  }

  .next__name {
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.04em;
    transition: color var(--dur-base) var(--ease-out-power3);
  }

  :global([dir='rtl']) .next__name {
    font-size: calc(var(--step-4) * 1.1);
    line-height: var(--ar-leading);
    letter-spacing: 0;
  }

  .next__go {
    inline-size: clamp(2rem, 4vw, 3rem);
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    transition:
      translate var(--dur-hover-out) var(--ease-out-expo),
      stroke var(--dur-base) var(--ease-out-power3);
  }

  .next__link:hover .next__name,
  .next__link:focus-visible .next__name {
    color: var(--accent);
  }

  .next__link:hover .next__go,
  .next__link:focus-visible .next__go {
    translate: 0.6rem 0;
    stroke: var(--accent);
    transition-duration: var(--dur-hover-in);
  }

  :global([dir='rtl']) .next__link:hover .next__go,
  :global([dir='rtl']) .next__link:focus-visible .next__go {
    translate: -0.6rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .facts__line,
    .facts__line::after {
      transform: none;
      scale: 1;
      transition: none;
    }
  }
</style>
