---
/*
  A project's pictures on a MacBook Pro's screen, one at a time, like a
  deck being shown. The MacBook is devices.css's (MIT), drawn in CSS at
  740 × 434 px with a 600 × 375 (16:10) screen; the pictures sit side by
  side on that screen and are swiped or stepped through with the arrows
  under the laptop, which also count where you are. 16:9 slides sit on
  the screen with a band of black above and below, as a deck shown full
  screen on a Mac does.

  devices.css draws at a fixed size, so the laptop is scaled down to fit
  narrower screens (--fit, set by the script), never up.

  The pictures snap into place as they're scrolled, so a phone swipes
  them with no script at all; the script drives the arrows, the count,
  the keys and the fit.
*/
import 'devices.css/dist/devices.min.css';

interface Props {
  title: string;
  pictures: string[];
  labels: { prev: string; next: string };
}

const { title, pictures, labels } = Astro.props;
const two = (n: number) => String(n).padStart(2, '0');
---

<figure class="deck u-wrap" data-deck data-reveal>
  <div class="mac" data-deck-fit>
    <div class="device device-macbook-pro">
      <div class="device-frame">
        <div
          class="device-screen mac__screen"
          data-deck-track
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label={title}
        >
          {
            pictures.map((src, i) => (
              <div class="mac__slide" data-deck-slide aria-label={`${i + 1} / ${pictures.length}`}>
                <img src={src} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
              </div>
            ))
          }
        </div>
      </div>
      <div class="device-stripe"></div>
      <div class="device-header"></div>
      <div class="device-sensors"></div>
      <div class="device-btns"></div>
      <div class="device-power"></div>
    </div>
  </div>

  {
    pictures.length > 1 && (
      <figcaption class="deck__controls">
        <span class="deck__count u-mono" aria-live="polite">
          <span data-deck-at>01</span> / {two(pictures.length)}
        </span>
        <span class="deck__arrows">
          <button class="deck__arrow" type="button" data-deck-step="-1" aria-label={labels.prev}>
            <svg class="u-flip" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 12H5M11 6l-6 6 6 6" />
            </svg>
          </button>
          <button class="deck__arrow" type="button" data-deck-step="1" aria-label={labels.next}>
            <svg class="u-flip" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h15M13 6l6 6-6 6" />
            </svg>
          </button>
        </span>
      </figcaption>
    )
  }
</figure>

<script>
  /** devices.css's MacBook Pro, in its own pixels. */
  const DEVICE_WIDTH = 740;

  function initDecks() {
    for (const deck of document.querySelectorAll<HTMLElement>('[data-deck]')) {
      const fit = deck.querySelector<HTMLElement>('[data-deck-fit]')!;
      const track = deck.querySelector<HTMLElement>('[data-deck-track]')!;
      const slides = [...deck.querySelectorAll<HTMLElement>('[data-deck-slide]')];
      const at = deck.querySelector<HTMLElement>('[data-deck-at]');
      const arrows = [...deck.querySelectorAll<HTMLButtonElement>('[data-deck-step]')];
      let current = 0;

      // Scaled to the room it has, never past its own size.
      new ResizeObserver(() => {
        fit.style.setProperty('--fit', String(Math.min(1, fit.clientWidth / DEVICE_WIDTH)));
      }).observe(fit);

      const show = (i: number) => {
        current = i;
        if (at) at.textContent = String(i + 1).padStart(2, '0');
        for (const arrow of arrows) {
          const step = Number(arrow.dataset.deckStep);
          arrow.disabled = (step < 0 && i === 0) || (step > 0 && i === slides.length - 1);
        }
      };

      // The slide most in view is the current one, however it got there.
      const seen = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) show(slides.indexOf(entry.target as HTMLElement));
          }
        },
        { root: track, threshold: 0.6 },
      );
      slides.forEach((slide) => seen.observe(slide));

      const rtl = () => getComputedStyle(track).direction === 'rtl';

      // Scrolled within the screen only, so the page itself stays put. In the
      // screen's own pixels, which the laptop's scaling leaves alone; scrolling
      // runs negative from the start when the page reads right to left.
      const go = (i: number) => {
        const index = Math.max(0, Math.min(slides.length - 1, i));
        // Counted now, not when the scroll settles, so quick clicks each move one on.
        show(index);
        const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        const left = index * track.clientWidth * (rtl() ? -1 : 1);
        track.scrollTo({ left, behavior: smooth ? 'smooth' : 'auto' });
      };

      for (const arrow of arrows) arrow.addEventListener('click', () => go(current + Number(arrow.dataset.deckStep)));

      // Arrow keys follow the reading direction: forward is right in English, left in Arabic.
      track.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const forward = (event.key === 'ArrowRight') === !rtl();
        go(current + (forward ? 1 : -1));
      });

      show(0);
    }
  }

  document.addEventListener('astro:page-load', initDecks);
</script>

<style>
  .deck {
    padding-block-start: var(--space-3xl);
  }

  /* ---- The MacBook ------------------------------------------------------ */

  /*
    Its box keeps the laptop's shape at whatever scale it's drawn, so the
    page flows round it; the laptop itself is scaled from its top centre.
  */
  .mac {
    --fit: 1;
    position: relative;
    max-inline-size: 740px;
    block-size: calc(434px * var(--fit));
    margin-inline: auto;
    /* Its width comes from the page, never from the 740px laptop inside. */
    contain: inline-size;
  }

  .mac .device {
    position: absolute;
    inset-block-start: 0;
    left: 50%;
    transform: translateX(-50%) scale(var(--fit));
    transform-origin: top center;
  }

  /* devices.css's screen, made the track the slides run along. */
  .mac__screen {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .mac__screen::-webkit-scrollbar {
    display: none;
  }

  .mac__screen:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .mac__slide {
    flex: 0 0 100%;
    block-size: 100%;
    scroll-snap-align: start;
  }

  .mac__slide img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  /* ---- Under it: where you are, and the way on ------------------------ */

  .deck__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    max-inline-size: 740px;
    margin-inline: auto;
    padding-block-start: var(--space-lg);
  }

  .deck__count {
    color: var(--ink-muted);
  }

  .deck__count [data-deck-at] {
    color: var(--ink);
  }

  .deck__arrows {
    display: flex;
    gap: var(--space-xs);
  }

  .deck__arrow {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    transition:
      color var(--dur-base) var(--ease-out-power3),
      background var(--dur-base) var(--ease-out-power3),
      border-color var(--dur-base) var(--ease-out-power3);
  }

  .deck__arrow:hover:not(:disabled),
  .deck__arrow:focus-visible {
    color: var(--paper);
    background: var(--accent);
    border-color: var(--accent);
  }

  .deck__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .deck__arrow svg {
    inline-size: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
</style>
