---
import { ClientRouter } from 'astro:transitions';
import SmoothScroll from '../components/layout/SmoothScroll';
import Cursor from '../components/layout/Cursor/Cursor';
import ScrollBar from '../components/layout/ScrollBar/ScrollBar';
import { getLocale, dirFor, locales, type Locale } from '../lib/i18n';
import Maintenance from '../components/layout/Maintenance.astro';
import Intro from '../components/layout/Intro.astro';
import { getMaintenance, getSite } from '../lib/content';
import { absolute, graph, jsonLd, pageUrl, type Crumb, type PageKind } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Locale-independent path, e.g. `/work/ecostone`. Drives hreflang. */
  path?: string;
  /**
   * False when this page exists in this language only (a blog post not
   * yet translated), so no alternate link points at a page that isn't there.
   */
  translated?: boolean;
  /** Open Graph type: `article` for a blog post. */
  ogType?: 'website' | 'article';
  /** The way down to this page for search results, from home, without the page itself. */
  trail?: Crumb[];
  /** What this page is, for structured data: an article, a project, or a plain page. */
  kind?: PageKind;
  /** The page's own share picture, 1200 × 630, by its path; the site's when left out. */
  image?: string;
  /**
   * False for a page search engines should leave out (the 404): it gets
   * noindex, and no canonical or language links, which belong to real pages.
   */
  indexed?: boolean;
}

const locale: Locale = getLocale(Astro.url);
const dir = dirFor(locale);
const content = getSite(locale);
/** In maintenance mode every page shows only the maintenance note. */
const paused = getMaintenance(locale).on;

const {
  title,
  description = content.description,
  path = Astro.url.pathname,
  translated = true,
  ogType = 'website',
  trail,
  kind,
  indexed = true,
  image = '/og-default.png',
} = Astro.props;
const alternates = translated ? locales : [locale];

const pageTitle = title ? `${title} — ${content.name}` : `${content.name} — ${content.tagline}`;
const canonical = pageUrl(path, locale);
const ogImage = absolute(image);
const structured = graph({ locale, path, title: title ?? pageTitle, description, trail, kind });
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      content.icon ? (
        <>
          <link rel="icon" href="/icon.png" type="image/png" />
          <link rel="apple-touch-icon" href="/icon-touch.png" />
        </>
      ) : (
        <>
          <link rel="icon" href="/favicon.ico" sizes="32x32" />
          <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
          <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        </>
      )
    }
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      indexed ? (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((alt) => (
            <link rel="alternate" hreflang={alt} href={pageUrl(path, alt)} />
          ))}
          {alternates.includes('ar') && <link rel="alternate" hreflang="x-default" href={pageUrl(path, 'ar')} />}
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={content.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_SY' : 'en_US'} />
    {alternates.length > 1 && <meta property="og:locale:alternate" content={locale === 'ar' ? 'en_US' : 'ar_SY'} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image === '/og-default.png' ? `${content.name} — ${content.tagline}` : (title ?? pageTitle)} />
    {kind?.type === 'article' && <meta property="article:published_time" content={kind.published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={jsonLd(structured)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500&family=IBM+Plex+Mono:wght@400&family=Lateef:wght@400;600&display=swap"
    />

    <ClientRouter />
    <slot name="head" />
  </head>

  <body>
    {/* The logo film, on a visit's first page; maintenance has an entrance of its own. */}
    {!paused && <Intro locale={locale} />}
    <a class="u-skip" href="#main">
      {locale === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}
    </a>
    <SmoothScroll client:idle />
    <ScrollBar client:idle />
    <Cursor client:idle />
    {
      paused ? (
        <Maintenance locale={locale} />
      ) : (
        <>
          <slot name="header" />
          <main id="main">
            <slot />
          </main>
          <slot name="footer" />
        </>
      )
    }

    <script>
      // One observer for every [data-reveal] on the page. Cheaper than
      // hydrating a component per section.
      //
      // Islands hydrate after this runs and React replaces the server-
      // rendered nodes, so observing once at startup silently loses them.
      // A MutationObserver picks up whatever appears later.
      const io =
        'IntersectionObserver' in window
          ? new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (!entry.isIntersecting) return;
                  entry.target.classList.add('is-revealed');
                  io.unobserve(entry.target);
                });
              },
              { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
            )
          : null;

      const seen = new WeakSet();

      const scan = () => {
        document.querySelectorAll('[data-reveal]:not(.is-revealed)').forEach((el) => {
          if (seen.has(el)) return;
          seen.add(el);
          if (io) io.observe(el);
          else el.classList.add('is-revealed');
        });
      };

      scan();
      document.addEventListener('astro:page-load', scan);
      document.addEventListener('astro:after-swap', scan);
      new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
    </script>
    <script>
      // Every [data-weightless] button floats toward the pointer. Same
      // reasoning as above: islands hydrate late and the ClientRouter
      // swaps the page, so look again whenever the DOM changes.
      import { initWeightless } from '../lib/motion/weightless';

      initWeightless();
      document.addEventListener('astro:page-load', initWeightless);
      new MutationObserver(initWeightless).observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>
